# Entorno de pruebas: se carga encima de .env cuando NODE_ENV=test (node ace test).
# Sobrescribe TODAS las variables DB_* para que las pruebas solo puedan tocar la
# base en memoria `db-test` de compose.yaml (puerto 54411), nunca la de desarrollo.
SESSION_DRIVER=memory

DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
